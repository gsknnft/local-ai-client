{
  "name": "@gsknnft/local-ai-client",
  "version": "0.1.0",
  "description": "Zero-runtime-dependency local AI client with WebGPU, WASM, native, and remote backend seams for browser, Capacitor, Node, and Android layers.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "examples",
    "README.md",
    "ROADMAP.md",
    "AUDIT.md"
  ],
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.json && node scripts/build-cjs.mjs",
    "demo": " node examples/bitnet-server.mjs",
    "dev": "tsc -p tsconfig.build.json --watch",
    "smoke": "node scripts/smoke.mjs",
    "smoke:remote": "node scripts/smoke-remote.mjs",
    "test": "vitest run",
    "pack:check": "pnpm pack --dry-run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "webllm",
    "mlc",
    "llm",
    "on-device",
    "capacitor",
    "android",
    "browser",
    "wasm",
    "webgpu"
  ],
  "peerDependencies": {
    "@huggingface/transformers": ">=4.2.0",
    "@mlc-ai/web-llm": ">=0.2.0"
  },
  "peerDependenciesMeta": {
    "@huggingface/transformers": {
      "optional": true
    },
    "@mlc-ai/web-llm": {
      "optional": true
    }
  },
  "devDependencies": {
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "4.1.5",
    "@vitest/coverage-v8": "4.1.5",
    "esbuild": "^0.28.1",
    "playwright": "^1.61.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
